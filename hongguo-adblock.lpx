#!name = 番茄去广告
#!desc = abclq/home-dns-adblock 两份文档清单移植：domain-list 51 条 + 案例补漏 29 条 + -hl/-lf 成对补齐 5 条，共 85 条；DOMAIN-SUFFIX 形式，只拦广告/追踪，不碰正片。
#!author = 000Nu11
#!homepage = https://github.com/000Nu11/fanqie-qx-rewrite
#!system = iOS
#!loon_version = 3.5.1(983)
#!date = 2026-10-29
#!tag = 番茄,去广告
#!type = normal

[Rule]
# 来源：abclq/home-dns-adblock docs/domain-list.md + docs/redguo-case-study.md
# 与现有 fanqie-loon.lpx 独立、可同时开启；本插件只 REJECT，下面是绝不拦的白名单：
#   qznovelvod.com / fqnovelvod.com 裸域、正片 *-reading-video、fqnovelpic.com、
#   douyinpic.com / byteimg.com / snssdk.com 裸域、is.snssdk.com（风控/设备注册）、
#   api3-normal-sinfonlinea.fqnovel.com（反作弊风控）、p{3,6,9}-novel-sign.byteimg.com（正片签名）、
#   douyincdn.com / douyinliving.com / bytegecko.com / volcgslb.com 等基础设施。
#   上游 dist 里的小红书/友盟/小米/DoH 域名与本插件无关，未收录。

# 一、domain-list 3.1 广告计费接口（6 条）
