# DP 4.1 对照补充（2026-11-07，FanQieDP.plugin；与我方 66 条逐条比对，20 条新增）
# 一、穿山甲广告联盟（开屏/章末/插屏/激励视频由穿山甲 SDK 下发）
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT
DOMAIN-SUFFIX,gromore.toutiao.com,REJECT
DOMAIN-KEYWORD,-ad-sign.byteimg.com,REJECT
# 二、广告监测与归因（曝光、点击上报）
DOMAIN,dig.bdurl.net,REJECT
DOMAIN,dig.zjurl.cn,REJECT
DOMAIN,mon.snssdk.com,REJECT
DOMAIN,mon.zijieapi.com,REJECT
DOMAIN,toblog.ctobsnssdk.com,REJECT
DOMAIN,adim.pinduoduo.com,REJECT
DOMAIN-SUFFIX,byteorge.com,REJECT
DOMAIN-SUFFIX,bytegoofy.com,REJECT
# 三、应用初始化 / 配置 / 埋点
DOMAIN,mcs.snssdk.com,REJECT
DOMAIN,security-lq.snssdk.com,REJECT
DOMAIN,tnc3-alisc1.snssdk.com,REJECT
DOMAIN,tnc3-aliec2.snssdk.com,REJECT
# 四、第三方广告与跳转
DOMAIN,api.iegadp.qq.com,REJECT
DOMAIN,apd-pcdnwxlogin.teg.tencent-cloud.net,REJECT
DOMAIN,activity-ag.awemeughun.com,REJECT
DOMAIN,msync-im1-vip6-std.easemob.com,REJECT
# 未采纳：DP 文件第五节默认注释的两条（DOMAIN-KEYWORD,zijieapi / DOMAIN-SUFFIX,bytedance.com）——zijieapi 整词命中评论区路径红线，不加。

# 说明：
# - 纯域名拦截，不含脚本、不含 MitM，避免与可莉通用广告平台拦截器冲突。
# - 图片 CDN（*.fqnovelpic.com、p11.douyinpic.com 等）刻意不拦，拦了会断书封面和头像。
# - QX 侧规则在 fanqie-qx.conf（同一仓库），两边同步维护。
# - 2026-11-07 DP 4.1 对照新增：20 条域名 + 下方 [Rewrite] 广告图路径（需 MitM 证书才生效）。
# - 观察清单：mcs.snssdk.com、tnc3-alisc1/aliec2.snssdk.com——评论区/登录/金币页异常先撤这三条；图片异常先关 [Rewrite]。

[Rewrite]
# 穿山甲素材域名已在 [Rule] 中整域拒绝，这里只处理「和正常图片共用 CDN」的广告路径（DP 4.1 原样）。
# 广告图片 → 返回 1x1 透明图，避免广告位裂图
^https?://.+\.(pstatp|pglstatp-toutiao)\.com/(obj|img)/web\.business\.image/ reject-img
^https?://.+\.pstatp\.com/obj/mosaic-legacy/.+\?from=ad reject-img
^https?://.+\.pstatp\.com/bytecom/resource/track_log/src/ reject-img
# 广告安装包、落地页资源
^https?://.+\.(pstatp|pglstatp-toutiao)\.com/(obj|img)/(ad-app-package|ad)/ reject
# 广告渲染器
^https?://.+\.pstatp\.com/obj/ad-pattern/renderer reject

[Mitm]
hostname = %APPEND% *.pstatp.com
